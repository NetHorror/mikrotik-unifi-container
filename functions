#!/usr/bin/env bash

log() {
    echo "$(date +"[%Y-%m-%d %T,%3N]") <docker-entrypoint> $*"
}

set_java_home() {
    JAVA_HOME=$(readlink -f /usr/bin/java | sed "s:/jre/bin/java::")
    if [ ! -d "${JAVA_HOME}" ]; then
        # For some reason readlink failed so lets just make some assumptions instead
        # We're assuming openjdk 8 since thats what we install in Dockerfile
        arch=`dpkg --print-architecture 2>/dev/null`
        JAVA_HOME=/usr/lib/jvm/java-17-openjdk-${arch}
    fi
}

instPkg() {
    for pkg in $*; do
        if [ $(dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -c "ok installed") -eq 0 ];
        then
            apt-get -qy install "${pkg}";
        fi
    done
}

# Validate that any included hotfixes have been applied
validate() (
  shopt -s nullglob
  for i in /usr/local/unifi/hotfixes/*-validate.md5sum; do
    md5sum -c "$i" > /dev/null 2>&1 || return 1
    echo "Hotfix validated: $(basename ${i::-16})"
  done
)

# Optional, opt-in (DISABLE_UOS_UPGRADE_NAG=true): auto-dismiss the
# "Upgrade to UniFi OS Server" modal shown to self-hosted installs, by
# injecting a small script into the webapp's index.html that clicks the
# controller's own "Remind Me Later" button. Idempotent (safe to run on
# every start) and a silent no-op if no index.html is found or the dialog's
# markup ever changes shape - no UniFi files are modified besides this one
# injected <script> tag. Kept on a single line so a plain sed substitution
# works regardless of whether index.html is pretty-printed or minified.
patch_uos_nag() {
  [ "${DISABLE_UOS_UPGRADE_NAG}" == "true" ] || return 0

  local marker="mikrotik-unifi-container: uos-nag-patch"
  local snippet="<!-- ${marker} v2 --><script>(function(){var a='data-mikrotik-unifi-container-uos-nag-patch';if(document.documentElement.hasAttribute(a))return;document.documentElement.setAttribute(a,'1');function dismiss(){var dialogs=document.querySelectorAll('[role=\"dialog\"]');for(var i=0;i<dialogs.length;i++){var d=dialogs[i];if(!/Upgrade to UniFi OS Server/i.test(d.textContent||''))continue;var btns=d.querySelectorAll('button');for(var j=0;j<btns.length;j++){if(/Remind Me Later/i.test(btns[j].textContent||'')){btns[j].click();return;}}}}dismiss();new MutationObserver(dismiss).observe(document.documentElement,{childList:true,subtree:true});window.addEventListener('load',dismiss);})();</script>"

  local file found=0 patched=0
  while IFS= read -r -d '' file; do
    found=$((found+1))
    grep -qF "${marker}" "$file" && continue

    if grep -q '</body>' "$file"; then
      sed -i "s#</body>#${snippet}</body>#" "$file"
    elif grep -q '</html>' "$file"; then
      sed -i "s#</html>#${snippet}</html>#" "$file"
    else
      printf '%s\n' "$snippet" >> "$file"
    fi

    # Drop any stale pre-gzipped sibling so the server can't keep serving the
    # unpatched copy instead of the file we just modified.
    [ -f "${file}.gz" ] && rm -f "${file}.gz"

    patched=$((patched+1))
  done < <(find "${BASEDIR}/webapps" -type f -iname "index.html" -print0 2>/dev/null)

  if [ "${found}" -eq 0 ]; then
    log "WARNING: DISABLE_UOS_UPGRADE_NAG=true but no index.html found under ${BASEDIR}/webapps to patch"
  elif [ "${patched}" -gt 0 ]; then
    log "Patched ${patched} index.html file(s) to auto-dismiss the UniFi OS Server upgrade nag (DISABLE_UOS_UPGRADE_NAG=true)"
  fi
}
